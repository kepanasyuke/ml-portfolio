{"presets":[{"name":"GMV, CM2 и CPO по городам","sql":"SELECT city,\n       round(sum(gmv), 2) AS gmv,\n       round(sum(gmv * margin_rate - delivery_cost), 2) AS cm2,\n       round(sum(promo_cost) / nullif(count(*), 0), 2) AS cpo\nFROM orders\nGROUP BY city\nORDER BY gmv DESC"},{"name":"Недельная динамика заказов","sql":"SELECT date_trunc('week', order_date) AS week,\n       count(*) AS orders,\n       round(sum(gmv), 2) AS gmv,\n       round(avg(gmv), 2) AS avg_check\nFROM orders\nGROUP BY 1\nORDER BY 1"},{"name":"Промо против органики","sql":"SELECT CASE WHEN promo_cost > 0 THEN 'promo' ELSE 'organic' END AS channel,\n       count(*) AS orders,\n       round(avg(gmv), 2) AS avg_gmv,\n       round(sum(gmv * margin_rate - delivery_cost), 2) AS cm2\nFROM orders\nGROUP BY 1\nORDER BY cm2 DESC"},{"name":"Категории по вкладу в CM2","sql":"SELECT category,\n       count(*) AS orders,\n       round(sum(gmv), 2) AS gmv,\n       round(sum(gmv * margin_rate - delivery_cost), 2) AS cm2,\n       round(avg(margin_rate), 3) AS margin_rate\nFROM orders\nGROUP BY category\nORDER BY cm2 DESC"},{"name":"Маржа и чек по сегментам","sql":"SELECT segment,\n       count(*) AS orders,\n       round(avg(gmv), 2) AS avg_check,\n       round(avg(margin_rate), 3) AS margin_rate,\n       approx_distinct(user_id) AS users\nFROM orders\nGROUP BY segment\nORDER BY avg_check DESC"}],"schema":[{"name":"order_id","type":"INTEGER"},{"name":"user_id","type":"INTEGER"},{"name":"city","type":"TEXT"},{"name":"segment","type":"TEXT"},{"name":"category","type":"TEXT"},{"name":"order_date","type":"TIMESTAMP"},{"name":"gmv","type":"REAL"},{"name":"margin_rate","type":"REAL"},{"name":"delivery_cost","type":"REAL"},{"name":"promo_cost","type":"INTEGER"}]}